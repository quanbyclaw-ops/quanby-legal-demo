# ─────────────────────────────────────────────────────────────────────────────
# Quanby Legal Platform – Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local or any file containing real secrets to version control.
# Compliant with RA 10173 (Data Privacy Act) – handle credentials with care.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string (Supabase, Neon, Railway, or local)
DATABASE_URL="postgresql://postgres:password@localhost:5432/quanby_legal_db?schema=public"

# Direct connection URL (for Prisma migrations, bypasses connection pooling)
DIRECT_URL="postgresql://postgres:password@localhost:5432/quanby_legal_db?schema=public"

# ── Clerk Authentication ───────────────────────────────────────────────────────
# Get these from https://dashboard.clerk.com → Your App → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
CLERK_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Clerk webhook signing secret (for user sync to database)
CLERK_WEBHOOK_SECRET="whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Clerk auth routes
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/dashboard"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/dashboard"

# ── AI / LLM ──────────────────────────────────────────────────────────────────
# Anthropic Claude (for Contract Agent analysis)
ANTHROPIC_API_KEY="sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# OpenAI (alternative provider)
OPENAI_API_KEY="sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# ── File Storage ──────────────────────────────────────────────────────────────
# Cloudflare R2 (recommended: S3-compatible, GDPR-friendly)
R2_ACCOUNT_ID="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
R2_ACCESS_KEY_ID="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
R2_SECRET_ACCESS_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
R2_BUCKET_NAME="quanby-legal-documents"
R2_PUBLIC_URL="https://pub-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev"

# AWS S3 (alternative)
AWS_ACCESS_KEY_ID="AKIAXXXXXXXXXXXXXXXX"
AWS_SECRET_ACCESS_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
AWS_REGION="ap-southeast-1"
AWS_S3_BUCKET="quanby-legal-documents"

# ── Email (Notifications) ─────────────────────────────────────────────────────
# Resend (recommended)
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
RESEND_FROM_EMAIL="notifications@quanbylegal.com"

# SMTP alternative
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"

# ── SMS Notifications (Philippines) ──────────────────────────────────────────
# Semaphore (Philippine SMS gateway)
SEMAPHORE_API_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
SEMAPHORE_SENDER_NAME="QUANBYLEGAL"

# ── Application ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Quanby Legal Platform"
NEXT_PUBLIC_APP_VERSION="1.0.0"

# Encryption key for sensitive data at rest (32 bytes, base64 encoded)
ENCRYPTION_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# JWT secret for internal API authentication
JWT_SECRET="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# ── Monitoring & Logging ──────────────────────────────────────────────────────
# Sentry
SENTRY_DSN="https://xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx@o0.ingest.sentry.io/0"
NEXT_PUBLIC_SENTRY_DSN="https://xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx@o0.ingest.sentry.io/0"

# ── Feature Flags ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_ENABLE_AI_ANALYSIS="true"
NEXT_PUBLIC_ENABLE_ENOTARIZATION="true"
NEXT_PUBLIC_ENABLE_CLIENT_PORTAL="true"
NEXT_PUBLIC_ENABLE_ANALYTICS="true"
NEXT_PUBLIC_MAINTENANCE_MODE="false"

# ── Environment ───────────────────────────────────────────────────────────────
NODE_ENV="development"
