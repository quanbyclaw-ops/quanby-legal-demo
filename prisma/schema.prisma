// Quanby Legal Platform – Case Management System
// Prisma Schema v2.0
// Standards: NIST SP 800-53, ISO 27001, RA 10173 (Data Privacy Act)
// Enhanced: Contract Agent, ContractTemplate, ContractChat, ENotarization

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  LAWYER
  PARALEGAL
  CLIENT
}

enum CaseType {
  CIVIL
  CRIMINAL
  LABOR
  ADMINISTRATIVE
  FAMILY
  COMMERCIAL
  SPECIAL_PROCEEDINGS
  ELECTION
  TAX
  ENVIRONMENTAL
}

enum CaseStatus {
  INTAKE
  SCREENING
  ASSIGNED
  PENDING_ASSIGNMENT
  ACTIVE
  ON_HOLD
  HEARING
  AWAITING_HEARING
  SUBMITTED
  AWAITING_DECISION
  DECIDED
  APPEALED
  CLOSED
  CLOSED_WON
  CLOSED_LOST
  CLOSED_SETTLED
  DISMISSED
  ARCHIVED
}

enum CasePriority {
  URGENT
  HIGH
  MEDIUM
  LOW
}

enum CourtLevel {
  BARANGAY
  MTC
  MTCC
  RTC
  CA
  SB
  SC
  NLRC
  DARAB
  COMELEC
  CTA
  OMBUDSMAN
}

enum DocumentType {
  COMPLAINT
  ANSWER
  MOTION
  ORDER
  RESOLUTION
  DECISION
  PLEADING
  AFFIDAVIT
  CONTRACT
  EVIDENCE
  NOTICE
  SUBPOENA
  WARRANT
  CERTIFICATE
  CORRESPONDENCE
  OTHER
  GENERATED_DRAFT
  UPLOADED
}

enum DocumentStatus {
  DRAFT
  REVIEW
  APPROVED
  FILED
  SERVED
  ARCHIVED
}

enum ContractStatus {
  DRAFT
  UPLOADED
  ANALYZING
  ANALYZED
  UNDER_REVIEW
  APPROVED
  SIGNED
  EXECUTED
  EXPIRED
  TERMINATED
  DISPUTED
}

enum ContractType {
  EMPLOYMENT
  SERVICE
  SERVICE_AGREEMENT
  RETAINER
  LEASE
  SALE
  PARTNERSHIP
  LOAN
  NDA
  MOA
  MOU
  DEED_OF_SALE
  DEED_OF_DONATION
  POWER_OF_ATTORNEY
  FRANCHISE
  CONSTRUCTION
  SUPPLY
  OTHER
}

enum AnalysisType {
  FULL_REVIEW
  CLAUSE_EXTRACTION
  RISK_ASSESSMENT
  COMPLIANCE_CHECK
  COMPARISON
}

enum AnalysisStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum ChatRole {
  USER
  AGENT
}

enum ENotarizationStatus {
  PENDING
  VERIFIED
  NOTARIZED
  REJECTED
}

enum NotificationType {
  CASE_ASSIGNED
  CASE_STATUS_CHANGED
  DEADLINE_REMINDER
  HEARING_SCHEDULED
  DOCUMENT_FILED
  DOCUMENT_APPROVED
  CONTRACT_ANALYZED
  CONTRACT_EXPIRING
  TASK_DUE
  SYSTEM_ALERT
  CLIENT_MESSAGE
}

enum EligibilityStatus {
  PENDING
  ELIGIBLE
  INELIGIBLE
  REQUIRES_REVIEW
}

enum TimelineEventType {
  CASE_CREATED
  STATUS_CHANGED
  LAWYER_ASSIGNED
  HEARING_SCHEDULED
  DOCUMENT_FILED
  DOCUMENT_RECEIVED
  TASK_COMPLETED
  NOTE_ADDED
  DEADLINE_SET
  CLIENT_CONTACTED
  COURT_ORDER
  PAYMENT_RECEIVED
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String   @unique
  firstName String
  lastName  String
  role      Role     @default(CLIENT)
  avatarUrl String?
  phone     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Lawyer-specific fields
  barNumber       String?
  specializations String[]
  maxCaseLoad     Int?     @default(20)

  // Relations
  assignedCases         Case[]             @relation("LawyerCases")
  clientProfile         Client?
  createdCases          Case[]             @relation("CreatedBy")
  notifications         Notification[]
  caseTimelines         CaseTimeline[]
  caseTasks             CaseTask[]         @relation("AssignedTo")
  createdTasks          CaseTask[]         @relation("CreatedBy")
  uploadedDocuments     Document[]
  uploadedContracts     Contract[]         @relation("ContractUploader")
  contractAnalyses      ContractAnalysis[] @relation("AnalyzedBy")
  createdTemplates      ContractTemplate[] @relation("TemplateCreator")
  contractChats         ContractChat[]

  @@index([clerkId])
  @@index([email])
  @@index([role])
  @@map("users")
}

model Client {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Personal information
  middleName    String?
  suffix        String?
  dateOfBirth   DateTime?
  gender        String?
  civilStatus   String?
  nationality   String  @default("Filipino")
  religion      String?

  // Address
  streetAddress String?
  barangay      String?
  municipality  String?
  province      String?
  region        String?
  zipCode       String?

  // Contact
  alternatePhone  String?
  alternateEmail  String?

  // Government IDs
  tinNumber      String?
  sssNumber      String?
  philhealthNumber String?
  pagibigNumber  String?
  votersIdNumber String?
  passportNumber String?

  // Financial / Eligibility
  monthlyIncome   Decimal?  @db.Decimal(12, 2)
  occupation      String?
  employer        String?
  eligibilityStatus EligibilityStatus @default(PENDING)
  eligibilityNotes  String?
  eligibilityReviewedAt DateTime?
  eligibilityReviewedBy String?

  // PAO eligibility (Public Attorney's Office criteria)
  isPaoEligible   Boolean @default(false)
  paoEligibilityScore Int?

  // Cases
  cases Case[]

  @@index([userId])
  @@index([eligibilityStatus])
  @@map("clients")
}

model Case {
  id        String   @id @default(cuid())
  caseNumber String  @unique
  title     String
  type      CaseType
  status    CaseStatus @default(INTAKE)
  priority  CasePriority @default(MEDIUM)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Description
  description      String?
  causeOfAction    String?
  reliefSought     String?
  factualBackground String?

  // Court information
  courtLevel       CourtLevel?
  courtName        String?
  courtBranch      String?
  courtDocket      String?
  judgeAssigned    String?
  prosecutorAssigned String?

  // Dates
  dateOfIncident   DateTime?
  dateOfFiling     DateTime?
  reglementaryDeadline DateTime?
  prescriptionDate DateTime?
  nextHearingDate  DateTime?
  closedAt         DateTime?

  // Relations
  clientId         String
  client           Client         @relation(fields: [clientId], references: [id])
  assignedLawyerId String?
  assignedLawyer   User?          @relation("LawyerCases", fields: [assignedLawyerId], references: [id])
  createdById      String
  createdBy        User           @relation("CreatedBy", fields: [createdById], references: [id])

  timeline         CaseTimeline[]
  tasks            CaseTask[]
  documents        Document[]
  notifications    Notification[]
  contracts        Contract[]

  // Metadata
  tags             String[]
  isConfidential   Boolean @default(false)
  opposingCounsel  String?
  opposingParty    String?
  estimatedValue   Decimal? @db.Decimal(15, 2)

  @@index([caseNumber])
  @@index([type])
  @@index([status])
  @@index([clientId])
  @@index([assignedLawyerId])
  @@index([reglementaryDeadline])
  @@map("cases")
}

model CaseTimeline {
  id        String   @id @default(cuid())
  caseId    String
  case      Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  eventType   TimelineEventType
  title       String
  description String?
  metadata    Json?

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id])

  @@index([caseId])
  @@index([createdAt])
  @@map("case_timelines")
}

model CaseTask {
  id        String   @id @default(cuid())
  caseId    String
  case      Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  title       String
  description String?
  dueDate     DateTime?
  completedAt DateTime?
  isCompleted Boolean  @default(false)
  priority    CasePriority @default(MEDIUM)

  assignedToId  String?
  assignedTo    User?   @relation("AssignedTo", fields: [assignedToId], references: [id])
  createdById   String
  createdBy     User    @relation("CreatedBy", fields: [createdById], references: [id])

  @@index([caseId])
  @@index([assignedToId])
  @@index([dueDate])
  @@map("case_tasks")
}

model Document {
  id        String   @id @default(cuid())
  caseId    String?
  case      Case?    @relation(fields: [caseId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  title       String
  type        DocumentType
  status      DocumentStatus @default(DRAFT)
  description String?

  // File storage
  fileName    String?
  fileSize    Int?
  mimeType    String?
  storageKey  String?
  storageUrl  String?

  // Generated document fields
  templateId  String?
  generatedContent String?

  // Filing information
  filedAt     DateTime?
  filedWith   String?
  receiptNumber String?

  // Notarization
  isNotarized    Boolean  @default(false)
  notarizedAt    DateTime?
  notaryName     String?
  notaryRollNo   String?
  docStampSerial String?

  uploadedById String?
  uploadedBy   User?   @relation(fields: [uploadedById], references: [id])

  eNotarization  ENotarization?

  @@index([caseId])
  @@index([type])
  @@index([status])
  @@map("documents")
}

model Contract {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  title       String
  type        ContractType
  status      ContractStatus @default(DRAFT)
  description String?

  // Parties (legacy simple fields kept for compat)
  partyA      String
  partyB      String
  partyAAddress String?
  partyBAddress String?

  // Parties (structured Json array: [{name, role, address}])
  parties     Json?

  // Dates
  executionDate    DateTime?
  effectiveDate    DateTime?
  expirationDate   DateTime?

  // File
  fileUrl     String?
  fileName    String?
  fileSize    Int?
  mimeType    String?
  storageKey  String?
  storageUrl  String?
  extractedText String? @db.Text

  // Value
  value          Decimal? @db.Decimal(15, 2)
  contractValue  Decimal? @db.Decimal(15, 2)
  currency       String  @default("PHP")

  // Relations
  analyses       ContractAnalysis[]
  chats          ContractChat[]

  linkedCaseId   String?
  linkedCase     Case?    @relation(fields: [linkedCaseId], references: [id])
  uploadedById   String?
  uploadedBy     User?    @relation("ContractUploader", fields: [uploadedById], references: [id])

  // Tags and metadata
  tags        String[]
  jurisdiction String @default("Philippines")
  governingLaw String @default("Philippine Law")

  @@index([type])
  @@index([status])
  @@index([expirationDate])
  @@index([linkedCaseId])
  @@index([uploadedById])
  @@map("contracts")
}

model ContractAnalysis {
  id         String   @id @default(cuid())
  contractId String
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  completedAt DateTime?

  // Analysis type and status
  analysisType   AnalysisType   @default(FULL_REVIEW)
  status         AnalysisStatus @default(PENDING)

  // Core AI Analysis Results
  summary          String?  @db.Text
  overallRiskScore Int?      // 1-100
  riskScore        Int?      // 0-100 (legacy alias)
  riskLevel        String?   // LOW, MEDIUM, HIGH, CRITICAL

  // Structured analysis output (new fields)
  keyClauses       Json?    // [{title, text, riskLevel, section}]
  risks            Json?    // [{severity, description, recommendation}]
  complianceFlags  Json?    // [{law, issue, severity, compliant}]
  suggestions      Json?    // [{priority, suggestion, rationale}]
  scCompliant      Boolean? // Supreme Court rules compliant

  // Legacy structured fields (kept for backward compat)
  keyObligations   Json?
  keyRights        Json?
  riskFactors      Json?
  recommendations  Json?
  missingClauses   Json?
  unusualClauses   Json?
  complianceIssues Json?

  // Philippine law specific
  applicableLaws      Json?
  courtJurisdiction   String?
  enforceabilityNotes String? @db.Text

  // Chat history (legacy, prefer ContractChat model)
  chatHistory      Json?

  // Meta
  analyzedById     String?
  analyzedBy       User?    @relation("AnalyzedBy", fields: [analyzedById], references: [id])
  modelUsed        String?
  tokensUsed       Int?
  analysisVersion  String  @default("2.0")

  @@index([contractId])
  @@index([analysisType])
  @@index([status])
  @@map("contract_analyses")
}

model ContractTemplate {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  name        String
  description String?
  category    String   // e.g. "NDA", "Service Agreement", "Retainer"
  content     String   @db.Text  // Full template body with {{variable}} placeholders
  variables   Json     // [{key, label, type, required, defaultValue}]
  isActive    Boolean  @default(true)

  createdById String?
  createdBy   User?    @relation("TemplateCreator", fields: [createdById], references: [id])

  @@index([category])
  @@index([isActive])
  @@map("contract_templates")
}

model ContractChat {
  id         String   @id @default(cuid())
  contractId String
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  message   String   @db.Text
  role      ChatRole @default(USER)
  metadata  Json?    // {analysisRef, clauseRef, riskRef}

  @@index([contractId])
  @@index([createdAt])
  @@map("contract_chats")
}

model ENotarization {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  documentId  String   @unique
  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  notaryId    String?
  status      ENotarizationStatus @default(PENDING)

  certificateNumber String?  @unique
  notarizedAt       DateTime?
  digitalSeal       String?  @db.Text  // Base64-encoded or PEM digital seal

  // Notary information
  notaryName    String?
  notaryRollNo  String?
  notaryPtrNo   String?     // Professional Tax Receipt No.
  notaryIbpNo   String?     // IBP Roll No.
  notaryMcleNo  String?     // MCLE compliance number

  // Verification
  verificationHash  String?  // SHA-256 hash for integrity
  verificationUrl   String?  // Public verification URL
  rejectionReason   String?

  metadata      Json?

  @@index([status])
  @@index([notaryId])
  @@map("e_notarizations")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  caseId    String?
  case      Case?    @relation(fields: [caseId], references: [id])
  createdAt DateTime @default(now())
  readAt    DateTime?

  type      NotificationType
  title     String
  message   String
  isRead    Boolean  @default(false)
  metadata  Json?
  actionUrl String?

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@map("notifications")
}
